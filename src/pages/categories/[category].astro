---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { postFilter } from "@/utils/postFilter";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter(postFilter);
  const categories = [...new Set(posts.map(post => post.data.category))];
  return categories.map(category => ({
    params: { category: slugifyStr(category) },
    props: {
      category,
      posts: posts.filter(post => post.data.category === category),
    },
  }));
}

const { category, posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`${category} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle={category}
    pageDesc={locale === "en"
      ? "Articles in this category."
      : "该分类下的全部文章。"}
  >
    <ul>
      {posts.map(post => <Card {...post} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
