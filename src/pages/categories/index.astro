---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { postFilter } from "@/utils/postFilter";
import { slugifyStr } from "@/utils/slugify";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const posts = (await getCollection("posts")).filter(postFilter);
const categoryCounts = posts.reduce<Record<string, number>>((counts, post) => {
  const category = post.data.category;
  counts[category] = (counts[category] ?? 0) + 1;
  return counts;
}, {});
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    {
      Object.keys(categoryCounts).length > 0 ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {Object.entries(categoryCounts).map(([category, count]) => (
            <li class="border-border border">
              <a
                href={getRelativeLocaleUrl(
                  locale,
                  `categories/${slugifyStr(category)}`
                )}
                class="hover:bg-muted flex items-center justify-between px-5 py-4"
              >
                <span class="font-bold">{category}</span>
                <span class="text-muted-foreground text-sm">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <p class="font-bold">
            {locale === "en" ? "No categories yet" : "暂时没有分类"}
          </p>
          <p class="text-muted-foreground mt-2">
            {locale === "en"
              ? "Categories will appear after the first article is published."
              : "发布第一篇文章后，分类会自动出现在这里。"}
          </p>
        </div>
      )
    }
  </Main>
  <Footer />
</Layout>
