---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import avatar from "@/assets/images/avatar.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const isEnglish = locale === "en";

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="grid min-h-[34rem] items-center gap-8 py-10 sm:gap-10 sm:py-16 md:grid-cols-[minmax(0,1fr)_19rem] md:py-20"
    >
      <div class="hero-copy">
        <p class="hairline-label mb-5">
          {
            isEnglish
              ? "Personal notes · Entrepreneurship"
              : "个人思考 · 创业探索"
          }
        </p>
        <h1
          class="max-w-3xl text-3xl leading-[1.2] font-black sm:text-[3.5rem] sm:leading-[1.12]"
        >
          {
            isEnglish ? (
              "Thinking clearly while building something real."
            ) : (
              <>
                <span class="block">在创造真实事物的路上，</span>
                <span class="block">保持清醒的思考。</span>
              </>
            )
          }
        </h1>
        <p
          class="text-muted-foreground mt-7 max-w-2xl text-base leading-8 sm:text-lg"
        >
          {
            isEnglish
              ? "Hi, I am blacking, an explorer on the road of entrepreneurship. This is where I keep honest notes about decisions, uncertainty and growth."
              : "你好，我是blacking，一个创业路上的探索者。这里记录选择、试错、成长，以及那些值得反复推敲的问题。"
          }
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="hero-action bg-foreground text-background inline-flex min-h-11 items-center gap-2 px-5 py-3 text-sm font-bold"
          >
            {isEnglish ? "Read the notes" : "阅读文章"}
            <IconArrowRight class="size-4 rtl:-rotate-180" />
          </LinkButton>
          <a
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="hero-action border-border inline-flex min-h-11 items-center gap-2 border px-5 py-3 text-sm font-bold"
          >
            <IconRss class="size-4" />
            RSS
          </a>
        </div>

        <div class="mt-9 flex items-center gap-3">
          <span class="text-muted-foreground text-sm">
            {isEnglish ? "Find me" : "找到我"}
          </span>
          <span class="bg-border h-px w-8" aria-hidden="true"></span>
          <Socials />
        </div>
      </div>

      <figure
        class="hero-portrait relative mx-auto w-full max-w-56 sm:max-w-76 md:mx-0"
      >
        <div
          class="border-border relative aspect-square overflow-hidden border bg-black"
        >
          <Image
            src={avatar}
            alt="blacking 的头像"
            widths={[304, 608]}
            sizes="(max-width: 768px) 304px, 304px"
            class="h-full w-full object-cover contrast-125 grayscale"
          />
          <div
            class="pointer-events-none absolute inset-0 border-12 border-white/8"
            aria-hidden="true"
          >
          </div>
        </div>
        <figcaption
          class="bg-foreground text-background absolute -right-3 -bottom-3 px-4 py-2 text-xs font-bold sm:-right-5"
        >
          blacking / 2026
        </figcaption>
      </figure>
    </section>

    <section class="editorial-rule grid gap-8 py-12 md:grid-cols-3">
      <div>
        <p class="hairline-label">01 / Observe</p>
        <h2 class="mt-3 text-xl font-bold">{isEnglish ? "Observe" : "观察"}</h2>
        <p class="text-muted-foreground mt-3 leading-7">
          {
            isEnglish
              ? "Look past the obvious answer and understand how things actually move."
              : "越过显而易见的答案，理解事物真正如何运转。"
          }
        </p>
      </div>
      <div>
        <p class="hairline-label">02 / Decide</p>
        <h2 class="mt-3 text-xl font-bold">{isEnglish ? "Decide" : "选择"}</h2>
        <p class="text-muted-foreground mt-3 leading-7">
          {
            isEnglish
              ? "Make decisions with incomplete information, then own their consequences."
              : "在信息不完整时做出选择，并承担选择带来的结果。"
          }
        </p>
      </div>
      <div>
        <p class="hairline-label">03 / Build</p>
        <h2 class="mt-3 text-xl font-bold">{isEnglish ? "Build" : "行动"}</h2>
        <p class="text-muted-foreground mt-3 leading-7">
          {
            isEnglish
              ? "Turn thoughts into experiments and let reality answer the remaining questions."
              : "把思考变成实验，让现实回答剩下的问题。"
          }
        </p>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="editorial-rule py-12">
          <p class="hairline-label">{t.home.featured}</p>
          <ul class="mt-5">
            {featuredPosts.map(data => (
              <Card variant="h2" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="recent-posts" class="editorial-rule py-12">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="hairline-label">Journal</p>
          <h2 class="mt-2 text-2xl font-bold">{t.home.recentPosts}</h2>
        </div>
        {
          sortedPosts.length > 0 && (
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="hidden items-center gap-1 text-sm font-bold sm:inline-flex"
            >
              {t.home.allPosts}
              <IconArrowRight class="size-4 rtl:-rotate-180" />
            </LinkButton>
          )
        }
      </div>

      {
        recentPosts.length > 0 ? (
          <ul class="mt-5">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        ) : (
          <div class="empty-state mt-7">
            <p class="text-lg font-bold">{t.home.emptyTitle}</p>
            <p class="text-muted-foreground mt-3 max-w-xl leading-7">
              {t.home.emptyDesc}
            </p>
            <p class="text-muted-foreground mt-6 text-sm">
              {isEnglish
                ? "New writing will appear here after it is published."
                : "发布新文章后，它会自动出现在这里。"}
            </p>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = document.querySelector<HTMLElement>("#main-content");
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.dataset.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.dataset.homePath ?? baseRoot
      );
    }
  });
</script>
